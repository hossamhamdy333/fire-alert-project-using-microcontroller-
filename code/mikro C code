
#define THRESHOLD_ALARM 60
#define THRESHOLD_FAULT 5

#define BUZZER_FIRE   PORTA.F6
#define BUZZER_FAULT  PORTA.F7
#define LED_HEALTHY   PORTA.F4
#define LED_ACT_SND   PORTA.F5

#define RELAY_Z34     PORTC.F0
#define RELAY_Z12     PORTC.F1

#define SW_UP1        PINB.F0
#define SW_DN3        PINB.F2
#define SW_ACK        PINB.F5
#define SW_ACTR       PINB.F6

short Fire_Alarm_Active = 0;
short Sensor_Fault_Active = 0;
short Buzzer_Muted = 0;

unsigned int temp_adc[4];
unsigned int temp_c[4];
short i;

void System_Init() {
  DDRA = 0xF0;
  PORTA = 0x10;

  DDRB = 0x80;
  PORTB = 0x7F;

  DDRC = 0x03;
  PORTC = 0x00;

  DDRD = 0xFF;
  PORTD = 0x00;

  ADC_Init();
}

void Read_Temperatures() {
    for(i=0; i<4; i++) {
        temp_adc[i] = ADC_Read(i);
        temp_c[i] = (unsigned long)temp_adc[i] * 500 / 1024;
    }
}

void main() {
  System_Init();

  while(1) {
    Read_Temperatures();

    Fire_Alarm_Active = 0;
    Sensor_Fault_Active = 0;

    PORTD = 0x00;
    PORTB.F7 = 0;

    for(i=0; i<4; i++) {
        if(temp_c[i] >= THRESHOLD_ALARM) {
            Fire_Alarm_Active = 1;
            if (i < 3) PORTD |= (1 << (i + 5));
            else PORTB.F7 = 1;
        }
        else if(temp_c[i] < THRESHOLD_FAULT) {
            Sensor_Fault_Active = 1;
            if (i == 0) PORTD.F0 = 1;
            else if (i == 1) PORTD.F2 = 1;
            else if (i == 2) PORTD.F3 = 1;
            else if (i == 3) PORTD.F4 = 1;
        }
    }

    if (Fire_Alarm_Active || Sensor_Fault_Active) {
        LED_HEALTHY = 0;
    } else {
        LED_HEALTHY = 1;
    }

    if (Buzzer_Muted) {
        BUZZER_FIRE = 0;
        BUZZER_FAULT = 0;
        Delay_ms(100);
    }
    else if (Fire_Alarm_Active) {
        BUZZER_FAULT = 0;

        BUZZER_FIRE = 1;
        LED_ACT_SND = 1;
        Delay_ms(100);

        BUZZER_FIRE = 0;
        LED_ACT_SND = 0;
        Delay_ms(100);
    }
    else if (Sensor_Fault_Active) {
        BUZZER_FIRE = 0;

        BUZZER_FAULT = 1;
        Delay_ms(500);

        BUZZER_FAULT = 0;
        Delay_ms(500);
    }
    else {
        BUZZER_FIRE = 0;
        BUZZER_FAULT = 0;
        Delay_ms(100);
    }

    if((temp_c[0] >= THRESHOLD_ALARM) && (temp_c[1] >= THRESHOLD_ALARM)) {
        RELAY_Z12 = 1;
    } else {
        RELAY_Z12 = 0;
    }

    if((temp_c[2] >= THRESHOLD_ALARM) && (temp_c[3] >= THRESHOLD_ALARM)) {
        RELAY_Z34 = 1;
    } else {
        RELAY_Z34 = 0;
    }

    if (SW_UP1 == 0) RELAY_Z12 = 1;
    if (SW_DN3 == 0) RELAY_Z34 = 1;

    if (SW_ACK == 0) {
        Delay_ms(20);
        if (SW_ACK == 0) Buzzer_Muted = 1;
    }

    if (SW_ACTR == 0) {
        Delay_ms(20);
        if (SW_ACTR == 0) Buzzer_Muted = 0;
    }
  }
}
